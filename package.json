{
  "name": "plotter-studio",
  "version": "0.1.0",
  "description": "Modern TypeScript + WebGPU hidden-line removal and procedural hatching library for pen plotters (SVG output)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build:shaders": "tsx scripts/build-shaders.ts",
    "build": "npm run build:shaders && tsc --noEmit && vite build",
    "preview": "vite preview",
    "plot:cli": "tsx src/cli/render-plots.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webgpu",
    "plotter",
    "pen-plotter",
    "svg",
    "hidden-line-removal",
    "generative-art",
    "hatching",
    "axidraw",
    "vgpu"
  ],
  "dependencies": {
    "three": "^0.180.0",
    "vgpu": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.180.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
